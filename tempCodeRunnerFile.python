    [1, 3, 5, 4, 4, 4, 5, 4, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 2, 2, 2, 3, 2, 3, 4, 3, 2, 2, 2, 2, 3, 3, 3, 2],
