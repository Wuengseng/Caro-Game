data = []

# Tạo 100 dòng đầu tiên
for i in range(100):
    row_data = [i + 1] + profiles[i % 10]
    data.append(row_data)

# Thêm 20 dòng bổ sung (ID từ 101 đến 120)
for i, profile in enumerate(extra_profiles):
    row_data = [100 + i + 1] + profile
    data.append(row_data)

columns = ['ID', 'Q1. Gender', 'Q2. Year of study', 'Q3. Faculty', 'Q4. Study Time', 'Q5. Proficiency', 
           'Q6', 'Q7', 'Q8', 'Q9_1', 'Q9_2', 'Q9_3', 'Q9_4', 'Q9_5', 
           'Q10_1', 'Q10_2', 'Q10_3', 'Q10_4', 'Q10_5', 
           'Q11', 'Q12', 'Q13', 'Q14', 'Q15', 'Q16', 'Q17', 'Q18', 
           'Q19', 'Q20', 'Q21', 'Q22', 'Q23', 'Q24', 'Q25', 'Q26']

df = pd.DataFrame(data, columns=columns)

# MAPPING DỮ LIỆU TỪ SỐ SANG CHỮ THEO ĐÚNG GOOGLE FORM
df['Q1. Gender'] = df['Q1. Gender'].map({
    1: 'Male (Nam)', 
    2: 'Female (Nữ)', 
    3: 'Other (Khác)'
})

df['Q2. Year of study'] = df['Q2. Year of study'].map({
    1: 'First year (Năm nhất)', 
    2: 'Second year (Năm hai)', 
    3: 'Third year (Năm ba)', 
    4: 'Fourth year (Năm tư)', 
    5: 'Fifth year or above (Năm thứ năm hoặc hơn)'
})

df['Q3. Faculty'] = df['Q3. Faculty'].map({
    1: 'Faculty of Information Technology (Khoa Công nghệ Thông tin)',
    2: 'Faculty of Civil Engineering (Khoa Xây dựng)',
    3: 'Faculty of Electrical and Electronics Engineering (Khoa Điện - Điện tử)',
    4: 'Faculty of Energy Engineering and Transport (Khoa Giao thông và Năng lượng)',
    5: 'Faculty of Mechanical Engineering (Khoa Cơ khí Chế tạo máy)',
    6: 'Faculty of Applied Sciences (Khoa Khoa học Ứng dụng)'
})

df['Q4. Study Time'] = df['Q4. Study Time'].map({
    1: 'Less than 5 years (Ít hơn 5 năm)',
    2: '5 - 7 years (5 - 7 năm)',
    3: '8 - 10 years (8 - 10 năm)',
    4: 'More than 10 years (Hơn 10 năm)'
})

df['Q5. Proficiency'] = df['Q5. Proficiency'].map({
    1: 'Beginner (Sơ cấp)',
    2: 'Elementary (Căn bản)',
    3: 'Intermediate (Trung cấp)',
    4: 'Upper-Intermediate (Trung cấp trên)',
    5: 'Advanced (Nâng cao)'
})

# Xuất file Excel
df.to_excel('Survey_Data_120_Raw_Text.xlsx', index=False)
print("Đã tạo thành công file Survey_Data_120_Raw_Text.xlsx gồm 120 dòng với định dạng chữ!")