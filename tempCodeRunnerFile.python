    [1, 2, 3, 3, 3, 3, 3, 3, 0, 1, 1, 0, 0, 0, 0, 0, 0, 1, 2, 3, 2, 1, 3, 4, 5, 4, 2, 2, 3, 1, 4, 3, 4, 3],
