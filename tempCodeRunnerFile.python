    [2, 3, 3, 4, 3, 3, 4, 3, 0, 1, 1, 0, 0, 0, 0, 0, 0, 1, 2, 1, 2, 3, 2, 4, 4, 4, 2, 2, 1, 2, 4, 2, 4, 4],
    [1, 4, 4, 3, 4, 4, 3, 4, 0, 0, 0, 1, 0, 0, 0, 1, 1, 0, 2, 2, 3, 4, 2, 3, 2, 4, 2, 4, 2, 5, 2, 4, 4, 5],
    [2, 2, 5, 2, 2, 3, 2, 2, 1, 1, 0, 0, 0, 1, 0, 1, 0, 0, 5, 2, 4, 1, 5, 2, 4, 1, 5, 2, 4, 1, 5, 2, 4, 1]
